#!/usr/bin/env bash
# install.sh — idempotent: static build into ~/.local/bin + cli-hub register.
set -euo pipefail
TOOL=<$ name $>                                     # scaffold: replace with the tool name
DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
command -v go >/dev/null 2>&1 || export PATH="$HOME/.local/go/bin:$PATH"
CGO_ENABLED=0 go build -C "$DIR" -trimpath -ldflags='-s -w' -o "$HOME/.local/bin/$TOOL" .
"$HOME/.local/bin/$TOOL" --version
echo "installed: $TOOL → ~/.local/bin/$TOOL (single static binary)"
command -v cli-hub >/dev/null 2>&1 && cli-hub register "$TOOL" --version "$("$HOME/.local/bin/$TOOL" --version)" \
  --description "<$ name $> — Go CLI" --group misc --source-path "$HOME/.local/bin/$TOOL" \
  --uninstall "$DIR/uninstall.sh" --reinstall "$DIR/install.sh" --yes || true
