// service.go — optional systemd add-on (Go tier; scaffolded with --service, spec §2.4,
// layout per references/systemd.md). User-scope unit: ~/.config/systemd/user/<tool>.service
// running `<tool> serve`; lingering enabled at install so the service survives logout.

package main

import (
	"context"
	"fmt"
	"log/slog"
	"os"
	"os/exec"
	"os/signal"
	"path/filepath"
	"strings"
	"syscall"
	"time"

	"github.com/spf13/cobra"
)

func init() { extraCmds = append(extraCmds, serviceCmd(), serveCmd()) }

const unitName = "<$ name $>.service"

func unitText() string {
	return `[Unit]
Description=<$ name $> service
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/<$ name $> serve
Restart=on-failure
RestartSec=5
Environment=NO_COLOR=1

[Install]
WantedBy=default.target
`
}

func unitPath() (string, error) {
	base, err := os.UserConfigDir() // honors $XDG_CONFIG_HOME
	if err != nil {
		return "", err
	}
	return filepath.Join(base, "systemd", "user", unitName), nil
}

// runCmd shells out to systemctl/journalctl; combined output lands on stderr (logs, not data).
func runCmd(name string, args ...string) error {
	cmd := exec.Command(name, args...)
	cmd.Stdout, cmd.Stderr = os.Stderr, os.Stderr
	return cmd.Run()
}

// systemctlStatus maps `is-active` to the doctor-compatible surface: `status: ok` (exit 0)
// or `status: missing` (exit 1); never `stale` — the unit file is regenerated by install.
func systemctlStatus() (int, error) {
	out, err := exec.Command("systemctl", "--user", "is-active", unitName).Output()
	state := strings.TrimSpace(string(out))
	if err == nil && state == "active" {
		_, _ = fmt.Fprintln(os.Stdout, "status: ok")
		return 0, nil
	}
	_, _ = fmt.Fprintln(os.Stdout, "status: missing")
	return 1, nil
}

func serviceCmd() *cobra.Command {
	cmd := &cobra.Command{Use: "service", Short: "Install and manage the systemd user service"}
	cmd.AddCommand(
		&cobra.Command{Use: "install", Short: "Write the unit, daemon-reload, enable --now, enable-linger", RunE: func(*cobra.Command, []string) error {
			path, err := unitPath()
			if err != nil {
				return cerr{1, err.Error(), "check $XDG_CONFIG_HOME"}
			}
			if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
				return cerr{1, err.Error(), "check the config directory"}
			}
			tmp := path + ".tmp" // atomic: write-then-rename keeps systemd from seeing a partial unit
			if err := os.WriteFile(tmp, []byte(unitText()), 0o644); err != nil {
				return cerr{1, err.Error(), "check the config directory"}
			}
			if err := os.Rename(tmp, path); err != nil {
				return cerr{1, err.Error(), "check the config directory"}
			}
			if err := runCmd("systemctl", "--user", "daemon-reload"); err != nil {
				return cerr{1, "systemctl daemon-reload failed: " + err.Error(), "is systemd available?"}
			}
			if err := runCmd("systemctl", "--user", "enable", "--now", unitName); err != nil {
				return cerr{1, "systemctl enable failed: " + err.Error(), "check `journalctl --user -u " + unitName + "`"}
			}
			if err := runCmd("loginctl", "enable-linger", os.Getenv("USER")); err != nil {
				return cerr{1, "loginctl enable-linger failed: " + err.Error(), "linger keeps the service alive after logout"}
			}
			slog.Info("service installed", "unit", path)
			return nil
		}},
		&cobra.Command{Use: "uninstall", Short: "Disable --now, remove the unit, daemon-reload", RunE: func(*cobra.Command, []string) error {
			_ = runCmd("systemctl", "--user", "disable", "--now", unitName)
			path, err := unitPath()
			if err == nil {
				_ = os.Remove(path)
				_ = runCmd("systemctl", "--user", "daemon-reload")
			}
			slog.Info("service uninstalled", "unit", unitName)
			return nil
		}})
	for _, sub := range []struct{ name, use string }{{"start", "start"}, {"stop", "stop"}, {"restart", "restart"}} {
		cmd.AddCommand(&cobra.Command{Use: sub.name, Short: "systemctl --user " + sub.name + " " + unitName, RunE: func(_ *cobra.Command, _ []string) error {
			return runCmd("systemctl", "--user", sub.name, unitName)
		}})
	}
	cmd.AddCommand(
		&cobra.Command{Use: "status", Short: "systemctl is-active, doctor-compatible surface (exit preserved)", RunE: func(*cobra.Command, []string) error {
			code, _ := systemctlStatus()
			if code != 0 {
				return cerr{code, "service is not active", "`service start` brings it up; `service install` first-time setup"}
			}
			return nil
		}},
		&cobra.Command{Use: "logs", Short: "journalctl --user -u <unit> (pager only on a TTY)", RunE: func(*cobra.Command, []string) error {
			return runCmd("journalctl", "--user", "-u", unitName, "-n", "20", "--no-pager")
		}},
	)
	return cmd
}

// serveCmd is the unit's ExecStart target: run the heartbeat loop until a signal arrives.
func serveCmd() *cobra.Command {
	return &cobra.Command{Use: "serve", Short: "Run the service loop (the systemd unit's ExecStart target)",
		RunE: func(*cobra.Command, []string) error {
			ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
			defer stop()
			slog.Info("serve: started; heartbeating every 30s until signal")
			for {
				select {
				case <-ctx.Done():
					slog.Info("serve: shutting down")
					return nil
				case <-time.After(30 * time.Second):
					slog.Debug("serve: heartbeat")
				}
			}
		}}
}
