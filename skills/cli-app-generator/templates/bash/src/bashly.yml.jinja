name: <$ name $>
help: |-
  <$ name $> bashly CLI skeleton; replace these commands with yours.
  Exit codes: 0 success, 1 error, 2 usage, 3 network, 4 partial.
version: 0.1.0
flags:
- long: --quiet
  short: -q
  help: Suppress non-essential stderr notes
commands:
- name: show
  help: Show a JSON object as NAME/VALUE rows
  args:
  - name: file
    help: 'JSON file; omit for the builtin <$ name $>'
    required: false
  flags:
  - long: --output
    short: -o
    arg: FORMAT
    help: Output format (table|json|csv|tsv)
    default: <$ 'csv' if audience == 'agent' else 'table' $>   # audience default
    allowed: [table, json, csv, tsv]
  - long: --json
    help: Shorthand for --output json
  - long: --no-color
    help: Disable ANSI output (output is plain regardless)
  examples:
  - <$ name $> show data.json
  - <$ name $> show data.json -o csv
- name: delete
  help: Delete a file (destructive)
  args:
  - name: file
    help: File to delete
    required: true
  flags:
  - long: --dry-run
    help: Print the plan to stdout; change nothing
  - long: --yes
    short: -y
    help: Execute; the tool never prompts, it refuses without --yes
- name: completions
  help: Print the bash completion script
  args:
  - name: shell
    help: Shell (bash only; completions are static, ble.sh-safe)
    required: false
