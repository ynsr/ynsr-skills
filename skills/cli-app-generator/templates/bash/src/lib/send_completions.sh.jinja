## [@bashly-upgrade completions send_completions]
send_completions() {
  echo $'# <$ name $> completion                                        -*- shell-script -*-'
  echo $''
  echo $'# This bash completions script was generated by'
  echo $'# completely (https://github.com/bashly-framework/completely)'
  echo $'# Modifying it manually is not recommended'
  echo $''
  echo $'_<$ name $>_completions_node_flag_state() {'
  echo $'  case "$1:$2" in'
  echo $'    0:--help|0:-h) return 0 ;;'
  echo $'    0:--version|0:-v) return 0 ;;'
  echo $'    0:--quiet|0:-q) return 0 ;;'
  echo $'    1:--output|1:-o) return 2 ;;'
  echo $'    1:--quiet|1:-q) return 0 ;;'
  echo $'    1:--help|1:-h) return 0 ;;'
  echo $'    1:--json) return 0 ;;'
  echo $'    1:--no-color) return 0 ;;'
  echo $'    2:--quiet|2:-q) return 0 ;;'
  echo $'    2:--help|2:-h) return 0 ;;'
  echo $'    2:--dry-run) return 0 ;;'
  echo $'    2:--yes|2:-y) return 0 ;;'
  echo $'    3:--quiet|3:-q) return 0 ;;'
  echo $'    3:--help|3:-h) return 0 ;;'
  echo $'  esac'
  echo $''
  echo $'  return 1'
  echo $'}'
  echo $''
  echo $'_<$ name $>_completions_option_seen() {'
  echo $'  local completed_option option_name'
  echo $'  for completed_option in "${completed_options[@]}"; do'
  echo $'    for option_name in "$@"; do'
  echo $'      [[ "$completed_option" == "$option_name" ]] && return 0'
  echo $'    done'
  echo $'  done'
  echo $''
  echo $'  return 1'
  echo $'}'
  echo $''
  echo $'_<$ name $>_completions_resolve_node() {'
  echo $'  node_id=0'
  echo $'  node_word_count=0'
  echo $'  positional_index=0'
  echo $''
  echo $'  local word'
  echo $'  for word in "${non_options[@]}"; do'
  echo $'    case "$node_id:$word" in'
  echo $'      0:show)'
  echo $'        node_id=1'
  echo $'        node_word_count=1'
  echo $'        ;;'
  echo $'      0:delete)'
  echo $'        node_id=2'
  echo $'        node_word_count=1'
  echo $'        ;;'
  echo $'      0:completions)'
  echo $'        node_id=3'
  echo $'        node_word_count=1'
  echo $'        ;;'
  echo $'      *)'
  echo $'        break'
  echo $'        ;;'
  echo $'    esac'
  echo $'  done'
  echo $''
  echo $'  positional_index=$((${#non_options[@]} - node_word_count))'
  echo $'}'
  echo $''
  echo $'_<$ name $>_completions() {'
  echo $'  local cur=${COMP_WORDS[COMP_CWORD]}'
  echo $'  local prev='
  echo $'  if ((COMP_CWORD > 0)); then'
  echo $'    prev=${COMP_WORDS[$((COMP_CWORD - 1))]}'
  echo $'  fi'
  echo $''
  echo $'  local completed=()'
  echo $'  if ((COMP_CWORD > 1)); then'
  echo $'    completed=("${COMP_WORDS[@]:1:$((COMP_CWORD - 1))}")'
  echo $'  fi'
  echo $''
  echo $'  local non_options=()'
  echo $'  local completed_options=()'
  echo $'  local node_id='
  echo $'  local node_word_count=-1'
  echo $'  local positional_index=0'
  echo $'  local invalid_completion=0'
  echo $'  local flag_state=0'
  echo $'  _<$ name $>_completions_resolve_node'
  echo $''
  echo $'  local skip_next=0'
  echo $'  for word in "${completed[@]}"; do'
  echo $'    if ((skip_next)); then'
  echo $'      skip_next=0'
  echo $'      continue'
  echo $'    fi'
  echo $''
  echo $'    if [[ "${word:0:1}" == "-" ]]; then'
  echo $'      _<$ name $>_completions_node_flag_state "$node_id" "$word"'
  echo $'      flag_state=$?'
  echo $'      if (( flag_state == 1 )); then'
  echo $'        invalid_completion=1'
  echo $'        break'
  echo $'      fi'
  echo $''
  echo $'      completed_options+=("$word")'
  echo $'      if (( flag_state == 2 )); then'
  echo $'        skip_next=1'
  echo $'      fi'
  echo $'      continue'
  echo $'    fi'
  echo $''
  echo $'    non_options+=("$word")'
  echo $'    _<$ name $>_completions_resolve_node'
  echo $'  done'
  echo $''
  echo $'  COMPREPLY=()'
  echo $'  (( invalid_completion )) && return'
  echo $''
  echo $'  case "$node_id:$prev" in'
  echo $'    1:--output|1:-o)'
  echo $'      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "table json csv tsv" -- "$cur")'
  echo $'      return'
  echo $'      ;;'
  echo $'  esac'
  echo $''
  echo $'  if [[ "${cur:0:1}" != "-" ]] && (( positional_index == 0 )); then'
  echo $'    case "$node_id" in'
  echo $'      0)'
  echo $'        while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "show delete completions" -- "$cur")'
  echo $'        return'
  echo $'        ;;'
  echo $'    esac'
  echo $'  fi'
  echo $''
  echo $'  if [[ "${cur:0:1}" == "-" ]]; then'
  echo $'    case "$node_id" in'
  echo $'      0)'
  echo $'        local words=()'
  echo $'        _<$ name $>_completions_option_seen "--help" "-h" || words+=("--help" "-h")'
  echo $'        _<$ name $>_completions_option_seen "--version" "-v" || words+=("--version" "-v")'
  echo $'        _<$ name $>_completions_option_seen "--quiet" "-q" || words+=("--quiet" "-q")'
  echo $'        while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "${words[*]}" -- "$cur")'
  echo $'        return'
  echo $'        ;;'
  echo $'      1)'
  echo $'        local words=()'
  echo $'        _<$ name $>_completions_option_seen "--quiet" "-q" || words+=("--quiet" "-q")'
  echo $'        _<$ name $>_completions_option_seen "--help" "-h" || words+=("--help" "-h")'
  echo $'        _<$ name $>_completions_option_seen "--output" "-o" || words+=("--output" "-o")'
  echo $'        _<$ name $>_completions_option_seen "--json" || words+=("--json")'
  echo $'        _<$ name $>_completions_option_seen "--no-color" || words+=("--no-color")'
  echo $'        while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "${words[*]}" -- "$cur")'
  echo $'        return'
  echo $'        ;;'
  echo $'      2)'
  echo $'        local words=()'
  echo $'        _<$ name $>_completions_option_seen "--quiet" "-q" || words+=("--quiet" "-q")'
  echo $'        _<$ name $>_completions_option_seen "--help" "-h" || words+=("--help" "-h")'
  echo $'        _<$ name $>_completions_option_seen "--dry-run" || words+=("--dry-run")'
  echo $'        _<$ name $>_completions_option_seen "--yes" "-y" || words+=("--yes" "-y")'
  echo $'        while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "${words[*]}" -- "$cur")'
  echo $'        return'
  echo $'        ;;'
  echo $'      3)'
  echo $'        local words=()'
  echo $'        _<$ name $>_completions_option_seen "--quiet" "-q" || words+=("--quiet" "-q")'
  echo $'        _<$ name $>_completions_option_seen "--help" "-h" || words+=("--help" "-h")'
  echo $'        while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "${words[*]}" -- "$cur")'
  echo $'        return'
  echo $'        ;;'
  echo $'    esac'
  echo $'  fi'
  echo $''
  echo $'  case "$node_id:$positional_index" in'
  echo $'    1:0)'
  echo $'      return'
  echo $'      ;;'
  echo $'    2:0)'
  echo $'      return'
  echo $'      ;;'
  echo $'    3:0)'
  echo $'      return'
  echo $'      ;;'
  echo $'  esac'
  echo $'} &&'
  echo $'  complete -F _<$ name $>_completions <$ name $>'
  echo $''
  echo $'# ex: filetype=sh'
}