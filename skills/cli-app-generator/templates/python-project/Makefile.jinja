CMD ?= .venv/bin/{{ name }}

.PHONY: check
check:
	uv sync -q
	uv run ruff check .
	uv run -- mypy src/
	uv run -- pytest -q tests
	@tmp=$$(mktemp -d) && \
		{{ env_prefix }}_CONFIG_DIR=$$tmp ./scripts/verify-cli $(CMD) "list widgets"{% if profiles %} "profile remove demo"{% endif %}; rc=$$?; rm -rf $$tmp; exit $$rc
