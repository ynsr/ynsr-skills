[project]
name = "{{ name }}"
dynamic = ["version"]
description = "{{ name }} — data-plane CLI{% if profiles %} for a profile-backed API{% endif %} (demo source is offline)."
readme = "README.md"
license = "MIT"
requires-python = ">=3.12"
dependencies = [
    "httpx[socks]>=0.28",   # socks extra: ALL_PROXY=socks5:// must work
    "platformdirs>=4",
    "prompt-toolkit>=3.0.53,<4",
    "pydantic>=2.12,<3",
    "questionary==2.1.1",
    "rich>=13.9",
    "tenacity>=9",
    "typer==0.27.2",
]


[project.scripts]
{{ name }} = "{{ name }}.cli:main"

[dependency-groups]
dev = ["pytest>=8.4", "ruff>=0.14"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.version]
path = "src/{{ name }}/__init__.py"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ name }}"]

[tool.ruff]
line-length = 120
target-version = "py312"

[tool.ruff.lint.per-file-ignores]
"src/{{ name }}/cli.py" = ["E402"]  # completion_init() must precede the typer-critical imports (spike B)
"tests/conftest.py" = ["E402"]  # sys.path bootstrap before imports

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "W"]

[tool.ruff.lint.flake8-bugbear]
extend-immutable-calls = ["typer.Option", "typer.Argument"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
