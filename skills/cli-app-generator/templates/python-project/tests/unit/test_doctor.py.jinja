"""Doctor status contract: first line `status: ok|missing`, --json single line, exit 0|1."""

import json

from typer.testing import CliRunner

from {{ name }} import doctor
from {{ name }}.cli import app

runner = CliRunner()


def test_status_ok_when_deps_present():
    result = runner.invoke(app, ["doctor"])
    assert result.exit_code == 0
    assert result.output.splitlines()[0] == "status: ok"


def test_json_single_line():
    result = runner.invoke(app, ["doctor", "--json"])
    assert result.exit_code == 0
    lines = result.output.strip().splitlines()
    assert len(lines) == 1 and json.loads(lines[0])["status"] == "ok"


def test_missing_dep_reported(monkeypatch):
    monkeypatch.setattr(doctor, "_missing_dep", lambda name: f"dep {name} not installed")
    result = runner.invoke(app, ["doctor"])
    assert result.exit_code == 1
    assert result.output.splitlines()[0] == "status: missing"


